# Configurações do Banco
POSTGRES_DB=VMF
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin000
DB_PORT=5431

# Configurações da Aplicação
SPRING_APPLICATION_NAME=ufccursos
